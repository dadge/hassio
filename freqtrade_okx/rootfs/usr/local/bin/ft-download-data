#!/usr/bin/env bash
# Download OKX 1h candles for the CURRENT dynamic pairlist into /data/user_data.
#
# Usage: ft-download-data [days] [--stake-currency USDT|USDC]
#          days             default 240 (~8 months)
#          --stake-currency backtest against a different quote currency than
#                           the bot is configured with. Useful on EEA accounts:
#                           USDC books are thin and young, so a meaningful
#                           backtest usually has to be run on USDT pairs even
#                           if you intend to trade USDC.
set -Eeuo pipefail

DAYS=240
STAKE_CCY=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stake-currency) STAKE_CCY="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) DAYS="$1"; shift ;;
    esac
done
[[ "$DAYS" =~ ^[0-9]+$ ]] || { echo "days must be a number (got '$DAYS')"; exit 2; }

CFG=/data/config_backtest.json
[[ -f "$CFG" ]] || { echo "Backtest config not found — start the add-on once first."; exit 1; }

LIVE_CFG=/data/config.json
if [[ -n "$STAKE_CCY" ]]; then
    [[ "$STAKE_CCY" == "USDT" || "$STAKE_CCY" == "USDC" ]] \
        || { echo "--stake-currency must be USDT or USDC (got '$STAKE_CCY')"; exit 2; }
    echo ">> Overriding the stake currency for this run: $STAKE_CCY"
    # Rewrite the quote currency everywhere it matters: the stake itself and
    # the leveraged-token blacklist entry, which is quote-specific.
    for src in "$LIVE_CFG" "$CFG"; do
        jq --arg c "$STAKE_CCY" \
           '.stake_currency = $c
            | .exchange.pair_blacklist =
                (.exchange.pair_blacklist | map(sub("/(USDT|USDC)$"; "/" + $c)))' \
           "$src" > "${src%.json}.ccy.json"
    done
    LIVE_CFG=/data/config.ccy.json
    CFG=/data/config_backtest.ccy.json
fi

echo ">> Resolving the current VolumePairList (uses live OKX tickers)..."
PAIRS_JSON="$(freqtrade test-pairlist --config "$LIVE_CFG" --print-json 2>/dev/null | tail -n 1)"
echo "$PAIRS_JSON" | jq -e 'type == "array" and length > 0' >/dev/null \
    || { echo "Could not resolve the pairlist (is OKX reachable?)."; exit 1; }
echo ">> $(echo "$PAIRS_JSON" | jq 'length') pairs selected."

STATIC_CFG=/data/config_backtest_static.json
jq --argjson pairs "$PAIRS_JSON" \
   '.exchange.pair_whitelist = $pairs | .pairlists = [{method: "StaticPairList"}]' \
   "$CFG" > "$STATIC_CFG"

echo ">> Downloading ${DAYS} days of 1h OHLCV (OKX serves only 100 candles per call — this takes a while)..."
freqtrade download-data \
    --config "$STATIC_CFG" \
    --userdir /data/user_data \
    --timeframe 1h \
    --days "$DAYS"
echo ">> Done. Data stored in /data/user_data/data/."
