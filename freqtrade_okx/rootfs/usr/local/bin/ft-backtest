#!/usr/bin/env bash
# Backtest ReboundStrategy on previously downloaded data (see ft-download-data).
#
# Usage: ft-backtest [timerange] [--stake-currency USDT|USDC]
#          timerange        default: the last ~6 months, e.g. 20260201-
#          --stake-currency backtest against a different quote currency than
#                           the bot runs with (run ft-download-data with the
#                           same flag first).
set -Eeuo pipefail

TIMERANGE=""
STAKE_CCY=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stake-currency) STAKE_CCY="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
        *) TIMERANGE="$1"; shift ;;
    esac
done
[[ -n "$TIMERANGE" ]] || TIMERANGE="$(date -d '6 months ago' +%Y%m%d)-"

STATIC_CFG=/data/config_backtest_static.json
[[ -f "$STATIC_CFG" ]] || { echo "Run ft-download-data first (it also builds the static pairlist config)."; exit 1; }

if [[ -n "$STAKE_CCY" ]]; then
    [[ "$STAKE_CCY" == "USDT" || "$STAKE_CCY" == "USDC" ]] \
        || { echo "--stake-currency must be USDT or USDC (got '$STAKE_CCY')"; exit 2; }
    CFG_CCY="$(jq -r '.stake_currency' "$STATIC_CFG")"
    [[ "$CFG_CCY" == "$STAKE_CCY" ]] || {
        echo "The downloaded data is for ${CFG_CCY} pairs, not ${STAKE_CCY}."
        echo "Run: ft-download-data --stake-currency ${STAKE_CCY}"
        exit 2
    }
fi

echo ">> Backtesting ReboundStrategy on $(jq -r '.stake_currency' "$STATIC_CFG") pairs, timerange ${TIMERANGE}..."
freqtrade backtesting \
    --config "$STATIC_CFG" \
    --userdir /data/user_data \
    --strategy ReboundStrategy \
    --timeframe 1h \
    --timerange "$TIMERANGE" \
    --export trades

cat <<'EOF'

>> How to read the summary above:
   * "Win  Draw  Loss  Win%"  — win rate. Rebound strategies typically land
     50-70% with the modest default +5% ROI target; a high target tanks this.
   * "Profit factor"          — gross wins / gross losses. > 1.2 is workable,
     < 1.0 loses money.
   * "Max % of account underwater (Absolute Drawdown)" — worst peak-to-valley.
     Compare it against what you can stomach before ever going live.
   * Also check "Exit Reason Stats": if most profit comes from `roi` and
     stop_loss exits stay contained, the edge is behaving as designed.
   * A handful of trades proves nothing either way — if the trade count is in
     single digits, widen the timerange or the pairlist before drawing any
     conclusion.
EOF
